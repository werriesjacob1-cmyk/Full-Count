{
  "manifest_version": 3,
  "name": "CarNow Lead Auto-Claimer",
  "version": "1.0.0",
  "description": "Watches CarNow dashboards for incoming leads and claims them automatically.",

  "minimum_chrome_version": "116",

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "https://*.carnow.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://*.carnow.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "CarNow Lead Auto-Claimer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
